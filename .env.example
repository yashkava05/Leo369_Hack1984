OLLAMA_HOST=http://localhost:11434
LATENT_MODEL=qwen2.5vl:3b
TAVILY_API_KEY=
EXA_API_KEY=
# Optional local voice adapter; run scripts/setup_voice.sh explicitly to install the model.
LATENT_STT_MODEL_PATH=~/.latent/models/faster-whisper-base.en
LATENT_STT_DEVICE=cpu
LATENT_STT_COMPUTE_TYPE=int8
LATENT_MOCK=0
# Opt-in: start a job for every new screenshot in this folder (e.g. ~/Desktop). Empty = off.
LATENT_WATCH_DIR=
LATENT_KEEP_THUMBS=0
# Demo safety net: serve recorded Tavily responses when a live call fails (docs/DEMO.md).
DEMO_FALLBACK=0
# Empty = same origin through the Vite dev proxy (recommended). Set a URL to call a remote backend.
VITE_API_URL=
VITE_MOCK=0
