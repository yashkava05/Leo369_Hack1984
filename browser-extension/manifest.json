{
  "manifest_version": 3,
  "name": "Latent Browser Bridge",
  "version": "0.1.0",
  "description": "Lets Latent read an Outlook on the web tab you explicitly share, read-only, for one confirmed request at a time.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage", "activeTab"],
  "optional_host_permissions": [
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://outlook.cloud.microsoft/*"
  ],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Share an Outlook tab with Latent", "default_popup": "popup.html" },
  "externally_connectable": { "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"] }
}
